---
import FunnelLayout from '../layouts/FunnelLayout.astro';
import { tela10 } from '../config/funnel';

const FONT_HREF = 'https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&display=swap';
---

<FunnelLayout title={tela10.title} fontHref={FONT_HREF} bodyDataPaleta={tela10.paleta}>
<style is:global>
/* ============================================================
   VITALLIA · Tela 10 de 12 — "A condição"
   Trabalho: transformar preço em GANHO CONQUISTADO.
   Pico emocional imediatamente antes da revelação do produto.

   Da referência: quebra total de paleta, cartão inclinado, giro,
   confete, som, botão escuro sobre fundo saturado.

   Contra a referência:
   · sem contador de "restam 39 vouchers" — número inventado
   · sem 85%: preço de tabela de R$ 247 nunca existiu
   · o código NÃO é decoração. É gerado da sessão, é único dela,
     e vai como parâmetro no link do checkout. Cupom de verdade.
   · o prazo é contado do resgate real dela e precisa expirar de
     verdade no back-end. Se você honrar depois, era mentira.
   ============================================================ */
:root{
  --ui:"Archivo",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  --ink:#20180A;
  --card:#FFFDF7;
  --dark:#10170A;
}
/* ouro: quebra de paleta mantendo o âmbar do funil inteiro */
[data-paleta="ouro"]{ --prize:#E8B03F; --prize-2:#F2C766; --deco:rgba(32,24,10,.13); }
/* lime da referência — paleta ativa */
[data-paleta="lima"]{ --prize:#C8EE41; --prize-2:#DAF869; --deco:rgba(18,26,10,.15); }

*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{font-family:var(--ui);-webkit-font-smoothing:antialiased;background:var(--prize);overflow:hidden}

.stage{position:relative;min-height:100svh;display:flex;flex-direction:column;
  align-items:center;justify-content:space-between;
  background:radial-gradient(120% 70% at 50% 12%,var(--prize-2) 0%,var(--prize) 62%);
  padding:calc(env(safe-area-inset-top) + 26px) 22px calc(env(safe-area-inset-bottom) + 24px);
  text-align:center;overflow:hidden}

canvas#confetti{position:fixed;inset:0;pointer-events:none;z-index:20}

/* enfeites flutuantes */
.deco{position:absolute;color:var(--deco);pointer-events:none;z-index:0}
.deco svg{width:100%;height:100%}
.d1{width:52px;height:52px;top:22%;left:5%;transform:rotate(-18deg)}
.d2{width:40px;height:40px;top:31%;right:6%;transform:rotate(14deg)}
.d3{width:34px;height:34px;bottom:27%;left:9%;transform:rotate(9deg)}
.d4{width:46px;height:46px;bottom:22%;right:7%;transform:rotate(-12deg)}
.spark{position:absolute;width:11px;height:11px;color:var(--deco);z-index:0}
.s1{top:27%;left:22%}.s2{top:20%;right:24%}.s3{bottom:31%;right:20%}.s4{bottom:36%;left:16%}

.head{position:relative;z-index:2;max-width:420px}
h1{font-weight:900;font-size:clamp(29px,8.4vw,40px);line-height:1.05;
  letter-spacing:-.035em;color:var(--ink)}
.sub{margin-top:12px;font-size:14px;line-height:1.5;color:var(--ink);opacity:.72;font-weight:500}
.sub b{opacity:1;font-weight:800}

/* ---- Cartão ---- */
.holder{position:relative;z-index:2;width:100%;max-width:290px;perspective:1400px;margin:6px 0}
.card{position:relative;width:100%;aspect-ratio:5/7;transform-style:preserve-3d;
  transform:rotate(-4deg);transition:transform 1.05s cubic-bezier(.5,.05,.2,1)}
.card.flip{transform:rotate(3deg) rotateY(1080deg)}
.face{position:absolute;inset:0;backface-visibility:hidden;
  background:var(--card);border-radius:20px;
  box-shadow:0 16px 40px rgba(32,24,10,.26);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:24px 20px;text-align:center}
.face.back{transform:rotateY(180deg)}

.seal{width:66px;height:66px;color:var(--ink);opacity:.9}
.face .lab{margin-top:18px;font-weight:800;font-size:20px;line-height:1.2;
  letter-spacing:-.025em;color:var(--ink)}
.face .tiny{margin-top:8px;font-size:11px;color:var(--ink);opacity:.55;font-weight:600;line-height:1.5}

.big{font-weight:900;font-size:clamp(34px,10vw,46px);line-height:.98;
  letter-spacing:-.045em;color:var(--ink)}
.big small{display:block;font-size:.36em;font-weight:800;letter-spacing:-.01em;margin-top:7px;opacity:.68}
.face .body{margin-top:14px;font-size:12.5px;line-height:1.5;color:var(--ink);opacity:.72;font-weight:500}

.code{margin-top:auto;padding-top:16px;width:100%}
.bars{display:flex;gap:1.5px;height:34px;justify-content:center;align-items:flex-end}
.bars i{background:var(--ink);border-radius:.5px}
.codenum{margin-top:7px;font-size:11px;letter-spacing:.24em;font-weight:700;color:var(--ink);opacity:.6}

/* ---- Rodapé ---- */
.foot{position:relative;z-index:2;width:100%;max-width:420px}
.btn{width:100%;height:62px;border:0;border-radius:31px;cursor:pointer;
  background:var(--dark);color:#FBF7EC;font-family:var(--ui);
  font-size:16.5px;font-weight:800;letter-spacing:-.015em;
  box-shadow:0 8px 26px rgba(32,24,10,.28);
  display:flex;align-items:center;justify-content:center;gap:10px}
.btn:active{transform:scale(.985)}
.btn svg{width:18px;height:18px}
.timer{margin-top:12px;font-size:12.5px;font-weight:700;color:var(--ink);opacity:.72;
  display:none;align-items:center;justify-content:center;gap:7px}
.timer.on{display:flex}
.timer svg{width:13px;height:13px}
.fine{margin-top:11px;font-size:9.5px;line-height:1.7;color:var(--ink);opacity:.5}

.mute{position:absolute;top:calc(env(safe-area-inset-top) + 14px);right:16px;z-index:3;
  width:34px;height:34px;border-radius:50%;cursor:pointer;
  background:rgba(32,24,10,.10);border:0;color:var(--ink);
  display:flex;align-items:center;justify-content:center}
.mute svg{width:16px;height:16px}

.stage.leaving{opacity:0;transform:scale(.97);transition:opacity .4s ease,transform .45s ease}
@media (prefers-reduced-motion:reduce){
  .card{transition:transform .3s ease}
  .card.flip{transform:rotate(3deg) rotateY(180deg)}
}
</style>

<canvas id="confetti"></canvas>

<div class="stage" id="stage">

  <button class="mute" id="mute" aria-label="Desligar som">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5L6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 010 7"/></svg>
  </button>

  <span class="deco d1"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M2 8a2 2 0 012-2h16a2 2 0 012 2v2a2 2 0 000 4v2a2 2 0 01-2 2H4a2 2 0 01-2-2v-2a2 2 0 000-4V8z"/></svg></span>
  <span class="deco d2"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M2 8a2 2 0 012-2h16a2 2 0 012 2v2a2 2 0 000 4v2a2 2 0 01-2 2H4a2 2 0 01-2-2v-2a2 2 0 000-4V8z"/></svg></span>
  <span class="deco d3"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.2H22l-6 4.4 2.3 7.2-6.3-4.6L5.7 20.8 8 13.6 2 9.2h7.6z"/></svg></span>
  <span class="deco d4"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M2 8a2 2 0 012-2h16a2 2 0 012 2v2a2 2 0 000 4v2a2 2 0 01-2 2H4a2 2 0 01-2-2v-2a2 2 0 000-4V8z"/></svg></span>
  <span class="spark s1"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0l2 10 10 2-10 2-2 10-2-10-10-2 10-2z"/></svg></span>
  <span class="spark s2"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0l2 10 10 2-10 2-2 10-2-10-10-2 10-2z"/></svg></span>
  <span class="spark s3"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0l2 10 10 2-10 2-2 10-2-10-10-2 10-2z"/></svg></span>
  <span class="spark s4"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0l2 10 10 2-10 2-2 10-2-10-10-2 10-2z"/></svg></span>

  <div class="head">
    <h1 id="title" set:html={tela10.head.titleDefault} />
    <p class="sub" id="sub"></p>
  </div>

  <div class="holder">
    <div class="card" id="card">

      <div class="face front">
        <span class="seal">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="10.5" width="16" height="11" rx="2.5"/>
            <path d="M8 10.5V7a4 4 0 018 0v3.5M12 15v2.5"/>
          </svg>
        </span>
        <p class="lab" set:html={tela10.card.frontLabel} />
        <p class="tiny" set:html={tela10.card.frontTiny} />
        <div class="code"><div class="bars" id="bars1"></div><p class="codenum" id="num1">— — —</p></div>
      </div>

      <div class="face back">
        <div id="reveal"></div>
        <div class="code"><div class="bars" id="bars2"></div><p class="codenum" id="num2"></p></div>
      </div>

    </div>
  </div>

  <div class="foot">
    <button class="btn" id="go">{tela10.go.default}</button>
    <p class="timer" id="timer">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
      <span id="clock"></span>
    </p>
    <p class="fine">{tela10.fine}</p>
  </div>
</div>

<script>
import { VT } from '../lib/track';
import { prefetch } from 'astro:prefetch';
import { tela10 } from '../config/funnel';

/* ============================================================
   CONFIG — a mesma da tela 9
   'material' → libera material real, não mexe em preço
   'desconto' → exige R$ 67 e R$ 19,90 praticados de verdade
   ============================================================ */
const CONDICAO = tela10.condicao;
const JANELA_H = tela10.janelaHoras; // horas de validade, enforçadas no back-end

const sim = JSON.parse(localStorage.getItem('vt_sim') || '{}');
const feita = !!sim.completed_at;

const STEP = { step: 10, step_name: 'a_condicao' };
VT.track('step_view', { ...STEP, sim_completed: feita, condicao: CONDICAO });
prefetch('/11');
prefetch('/5');

/* ---- cupom real, derivado da sessão ---- */
function cupom() {
  let h = 0; const s = VT.sid;
  for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0;
  return 'VTL' + String(h % 100000000).padStart(8, '0');
}
const CODE = cupom();

function bars(el: HTMLElement) {
  el.innerHTML = '';
  for (let i = 0; i < 44; i++) {
    const b = document.createElement('i');
    b.style.width = (Math.random() < .3 ? 3 : 1.5) + 'px';
    b.style.height = (70 + Math.random() * 30) + '%';
    el.appendChild(b);
  }
}
bars(document.getElementById('bars1')!);
bars(document.getElementById('bars2')!);

const sub = document.getElementById('sub')!, go = document.getElementById('go') as HTMLButtonElement;

if (feita) {
  sub.innerHTML = tela10.head.subFeita;
} else {
  document.getElementById('title')!.innerHTML = tela10.head.titleNaoFeita;
  sub.innerHTML = tela10.head.subNaoFeita;
  go.textContent = tela10.go.naoFeita;
  go.addEventListener('click', () => {
    VT.track('sim_return', STEP);
    window.location.href = `/5?s=${VT.sid}&from=10`;
  }, { once: true });
}

/* ---- som de prêmio, sintetizado ---- */
let mudo = false;
const muteBtn = document.getElementById('mute')!;
muteBtn.addEventListener('click', () => {
  mudo = !mudo;
  muteBtn.innerHTML = mudo
    ? '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 5L6 9H2v6h4l5 4V5z"/><path d="M22 9l-6 6M16 9l6 6"/></svg>'
    : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5L6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 010 7"/></svg>';
});

function premio() {
  if (mudo) return;
  try {
    const A = new (window.AudioContext || (window as any).webkitAudioContext)();
    const notas = [523.25, 659.25, 783.99, 1046.50, 1318.51];
    notas.forEach((f, i) => {
      const o = A.createOscillator(), g = A.createGain();
      o.type = 'triangle'; o.frequency.value = f;
      const t = A.currentTime + i * 0.085;
      g.gain.setValueAtTime(0, t);
      g.gain.linearRampToValueAtTime(.16, t + 0.012);
      g.gain.exponentialRampToValueAtTime(.0001, t + 0.55);
      o.connect(g); g.connect(A.destination);
      o.start(t); o.stop(t + 0.6);
    });
    /* brilho no fim */
    const n = A.createOscillator(), ng = A.createGain();
    n.type = 'sine'; n.frequency.setValueAtTime(1568, A.currentTime + .42);
    ng.gain.setValueAtTime(.09, A.currentTime + .42);
    ng.gain.exponentialRampToValueAtTime(.0001, A.currentTime + 1.15);
    n.connect(ng); ng.connect(A.destination);
    n.start(A.currentTime + .42); n.stop(A.currentTime + 1.2);
  } catch (e) {}
}

/* ---- confete ---- */
const cv = document.getElementById('confetti') as HTMLCanvasElement, cx = cv.getContext('2d')!;
function size() {
  cv.width = innerWidth * devicePixelRatio; cv.height = innerHeight * devicePixelRatio;
  cx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
}
size(); addEventListener('resize', size);

function confete() {
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const cores = ['#3B7DD8', '#E24B4B', '#F2C641', '#3FBF6B', '#F08B2E', '#FFFFFF', '#10170A'];
  const P: any[] = [];
  for (let i = 0; i < 150; i++) {
    const a = Math.random() * Math.PI * 2, v = 6 + Math.random() * 11;
    P.push({
      x: innerWidth / 2, y: innerHeight * 0.46,
      vx: Math.cos(a) * v, vy: Math.sin(a) * v - 7,
      w: 5 + Math.random() * 7, h: 8 + Math.random() * 9,
      r: Math.random() * 6.28, vr: (Math.random() - .5) * .34,
      c: cores[(Math.random() * cores.length) | 0], life: 1,
    });
  }
  (function tick() {
    cx.clearRect(0, 0, innerWidth, innerHeight);
    let vivos = 0;
    P.forEach(p => {
      if (p.life <= 0) return;
      vivos++;
      p.vy += 0.32; p.vx *= 0.992; p.x += p.vx; p.y += p.vy; p.r += p.vr;
      if (p.y > innerHeight * 0.62) p.life -= 0.014;
      cx.save(); cx.globalAlpha = Math.max(0, p.life);
      cx.translate(p.x, p.y); cx.rotate(p.r);
      cx.fillStyle = p.c; cx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
      cx.restore();
    });
    if (vivos) requestAnimationFrame(tick); else cx.clearRect(0, 0, innerWidth, innerHeight);
  })();
}

/* ---- revelação ---- */
const REVEAL = tela10.revealByCondicao[CONDICAO];

let resgatado = false, advanced = false;

if (feita) {
  go.addEventListener('click', () => {
    if (resgatado) return;
    resgatado = true;

    document.getElementById('reveal')!.innerHTML = REVEAL;
    document.getElementById('num1')!.textContent = CODE;
    document.getElementById('num2')!.textContent = CODE;
    document.getElementById('card')!.classList.add('flip');

    navigator.vibrate?.([14, 50, 26]);
    setTimeout(premio, 420);
    setTimeout(confete, 560);

    const ate = Date.now() + JANELA_H * 3600 * 1000;
    localStorage.setItem('vt_cond', JSON.stringify({
      code: CODE, tipo: CONDICAO, resgatado_em: new Date().toISOString(),
      expira_em: new Date(ate).toISOString(),
    }));

    VT.track('condicao_resgatada', { ...STEP, code: CODE, tipo: CONDICAO });

    setTimeout(() => {
      document.getElementById('title')!.innerHTML = tela10.afterRedeem.title;
      sub.innerHTML = tela10.afterRedeem.sub;
      go.innerHTML = `${tela10.go.resgatado} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6"/></svg>`;
      document.getElementById('timer')!.classList.add('on');
      relogio(ate);
      go.onclick = () => {
        if (advanced) return; advanced = true;
        VT.track('step_advance', { ...STEP, code: CODE });
        document.getElementById('stage')!.classList.add('leaving');
        setTimeout(() => {
          window.location.href = `/11?s=${VT.sid}`;
        }, 400);
      };
    }, 1150);
  });
}

function relogio(ate: number) {
  const el = document.getElementById('clock')!;
  (function t() {
    const d = ate - Date.now();
    if (d <= 0) { el.textContent = 'condição expirada'; return; }
    const h = Math.floor(d / 3.6e6), m = Math.floor(d % 3.6e6 / 6e4), s = Math.floor(d % 6e4 / 1000);
    el.textContent = `vale por ${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    setTimeout(t, 1000);
  })();
}

function reportExit() { if (!advanced) VT.track('step_exit', { ...STEP, resgatado, sim_completed: feita }); }
document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden') reportExit(); });
window.addEventListener('pagehide', reportExit);
</script>

{/*
  O QUE PRECISA SER VERDADE PARA ESTA TELA PODER EXISTIR

  1. O código tem que ser aceito no checkout. Ele é derivado da sessão,
     gravado em 'vt_cond' e deve ir como parâmetro na URL da Hotmart.
     Se o cupom não existir do outro lado, a tela vira encenação.

  2. O relógio de 24h tem que expirar de verdade no back-end. Se ela
     voltar depois de 30h e você vender pelo mesmo preço, era mentira —
     independentemente do que estava escrito aqui.

  3. Em CONDICAO='desconto', R$ 67 e R$ 19,90 precisam ser praticados
     na página avulsa por no mínimo 30 dias antes de servirem de âncora,
     e mantidos depois. Sem isso, use 'material'.

  4. Em CONDICAO='material', o material revelado NÃO pode aparecer na
     oferta avulsa. Se aparecer, a frase "não está na oferta avulsa"
     é falsa e ela descobre no primeiro acesso.

  O QUE FICOU DE FORA DA REFERÊNCIA, DE PROPÓSITO
  · "Restam apenas 39 vouchers até 1.000 membros" — contador inventado
  · 85% — exigiria preço de tabela de R$ 247, que nunca existiu
  · a palavra "premiado" e o trevo: sugerem sorteio. Não há sorteio.
    Há uma troca: ela deu cinco respostas, recebe uma condição.
*/}
</FunnelLayout>
