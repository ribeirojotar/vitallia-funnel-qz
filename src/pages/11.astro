---
import FunnelLayout from '../layouts/FunnelLayout.astro';
import { tela11 } from '../config/funnel';

const FONT_HREF = 'https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=Bodoni+Moda:ital,opsz,wght@1,6..96,500&display=swap';
---

<FunnelLayout title={tela11.title} fontHref={FONT_HREF}>
<style is:global>
/* ============================================================
   VITALLIA · Tela 11 de 12 — "O que estava por trás"
   Trabalho: dar SUBSTÂNCIA AVALIÁVEL. Os seis passos que ela já
   aceitou viram seis cursos com certificado próprio.

   Da referência:
   · troca de temperatura — depois do prêmio, fundo claro e sóbrio.
     A lista de entregáveis vira catálogo, não pitch.
   · cards brancos com borda colorida à esquerda, rótulo curto:
     mesmo componente das negações da tela 3
   · foto com tarja de legenda embaixo

   O que a nossa faz e a dele não pode:
   · os seis passos vêm ORDENADOS pelas lacunas da simulação.
     O chat dele não pergunta nada, então não tem o que ordenar.
   · a condição resgatada continua visível numa faixa fixa, com o
     código real e o relógio real. Sem isso, o pico da tela 10
     evapora antes da tela de preço.
   ============================================================ */
:root{
  --display:"Archivo",-apple-system,BlinkMacSystemFont,sans-serif;
  --serif:"Bodoni Moda",Didot,Georgia,serif;
  --ui:"Archivo",-apple-system,BlinkMacSystemFont,sans-serif;

  --paper:#EFEADD;
  --paper-2:#F7F3E9;
  --ink:#16241D;
  --ink-dim:#5E6B60;
  --card:#FFFFFF;
  --card-bd:#E2DCCC;
  --green:#2E7D52;
  --amber:#B8802A;
  --amber-bg:#FBF1DC;
  --amber-bd:#E2C489;
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--paper);color:var(--ink);font-family:var(--ui);-webkit-font-smoothing:antialiased}
.stage{position:relative;min-height:100svh;display:flex;flex-direction:column;
  background:linear-gradient(180deg,var(--paper-2) 0%,var(--paper) 42%)}
.thread{position:fixed;top:0;left:0;height:2px;width:91.6%;background:var(--amber);opacity:.6;z-index:12}
.wrap{position:relative;z-index:2;max-width:560px;width:100%;margin:0 auto;padding:0 20px}

/* ---- faixa da condição, fixa ---- */
.strip{position:sticky;top:0;z-index:10;
  background:var(--amber-bg);border-bottom:1px solid var(--amber-bd);
  padding:calc(env(safe-area-inset-top) + 9px) 20px 9px}
.strip .in{max-width:560px;margin:0 auto;display:flex;align-items:center;gap:10px;
  font-size:11.5px;font-weight:700;color:var(--amber)}
.strip svg{width:14px;height:14px;flex:none}
.strip .code{margin-left:auto;letter-spacing:.13em;font-size:10.5px;opacity:.8}

main{flex:1;padding:22px 0 24px}

.reward{background:var(--card);border:1px solid var(--card-bd);border-radius:14px;
  padding:13px 15px;font-size:13.5px;line-height:1.5;color:var(--ink-dim);text-align:center}
.reward b{color:var(--ink);font-weight:700}

/* ---- foto com tarja ---- */
.shot{margin-top:18px;position:relative;border-radius:18px;overflow:hidden;
  aspect-ratio:16/10;background:linear-gradient(150deg,#DED7C4,#CFC7B2);
  display:flex;align-items:center;justify-content:center}
.shot span{font-size:10px;letter-spacing:.15em;text-transform:uppercase;
  color:#8A8271;line-height:2;text-align:center;padding:24px}
.shot .cap{position:absolute;left:12px;bottom:12px;right:12px;
  background:rgba(22,36,29,.90);color:#F1EDE1;border-radius:10px;
  padding:9px 13px;font-size:12.5px;font-weight:600;line-height:1.35}

h1{margin-top:22px;font-family:var(--display);font-weight:800;
  font-size:clamp(24px,6.4vw,32px);line-height:1.14;letter-spacing:-.03em;text-wrap:balance}
h1 em{font-style:normal;color:var(--green)}
.lede{margin-top:11px;font-size:14.5px;line-height:1.55;color:var(--ink-dim);max-width:38ch}

/* ---- os seis passos ---- */
.steps{margin-top:20px;display:flex;flex-direction:column;gap:9px}
.step{background:var(--card);border:1px solid var(--card-bd);border-left:3px solid var(--green);
  border-radius:13px;padding:14px 15px}
.step.hit{border-left-color:var(--amber);background:#FFFCF4}
.step .top{display:flex;align-items:baseline;gap:9px}
.step .n{font-size:11px;font-weight:800;color:var(--ink-dim);opacity:.55;flex:none}
.step h3{font-size:15px;font-weight:700;letter-spacing:-.015em;line-height:1.25}
.step p{margin-top:5px;padding-left:20px;font-size:13px;line-height:1.48;color:var(--ink-dim)}
.step .why{margin-top:9px;margin-left:20px;display:inline-flex;align-items:center;gap:6px;
  padding:5px 10px;border-radius:99px;background:var(--amber-bg);border:1px solid var(--amber-bd);
  font-size:11px;font-weight:700;color:var(--amber)}
.step .why svg{width:11px;height:11px}

/* ---- e mais ---- */
.more{margin-top:22px;background:var(--card);border:1px solid var(--card-bd);border-radius:18px;padding:17px 16px}
.more h4{font-size:9.5px;letter-spacing:.17em;text-transform:uppercase;font-weight:800;
  color:var(--ink-dim);margin-bottom:12px}
.more li{list-style:none;display:flex;gap:11px;align-items:flex-start;padding:7px 0;
  font-size:14px;line-height:1.45;border-top:1px solid var(--card-bd)}
.more li:first-of-type{border-top:0}
.more li svg{width:16px;height:16px;flex:none;margin-top:2px;color:var(--green)}
.more li b{font-weight:700}
.more li span{color:var(--ink-dim);font-size:12.5px;display:block;margin-top:2px}

.foot{position:sticky;bottom:0;z-index:9;padding:14px 0 calc(env(safe-area-inset-bottom) + 14px);
  background:linear-gradient(to top,var(--paper) 55%,transparent)}
.foot button{width:100%;height:62px;border:0;border-radius:31px;cursor:pointer;
  display:flex;align-items:center;justify-content:center;gap:11px;
  background:var(--green);color:#fff;font-family:var(--ui);font-size:16px;font-weight:700;
  box-shadow:0 6px 22px rgba(46,125,82,.26)}
.foot svg{width:18px;height:18px}
.fine{padding:8px 0 calc(env(safe-area-inset-bottom) + 12px);text-align:center;
  font-size:9.5px;line-height:1.7;color:var(--ink-dim);opacity:.7}
.stage.leaving{opacity:0;transform:translateX(-6%);
  transition:opacity .42s ease,transform .48s cubic-bezier(.6,0,.35,1)}
</style>
<i class="thread"></i>
<div class="stage" id="stage">

  <div class="strip" id="strip" style="display:none">
    <div class="in">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
      <span id="clock">—</span>
      <span class="code" id="code"></span>
    </div>
  </div>

  <main class="wrap">

    <p class="reward" id="reward"></p>

    <div class="shot">
      <span>slot · foto real<br>os cinco materiais impressos sobre a mesa</span>
      <p class="cap">{tela11.shotCaption}</p>
    </div>

    <h1 set:html={tela11.headline} />
    <p class="lede" id="lede">{tela11.lede}</p>

    <div class="steps" id="steps"></div>

    <section class="more">
      <h4>{tela11.more.heading}</h4>
      <ul>
        {tela11.more.items.map(item => (
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            <div><b>{item.b}</b><span>{item.span}</span></div>
          </li>
        ))}
      </ul>
    </section>

  </main>

  <div class="wrap foot">
    <button id="advance">{tela11.cta}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6"/></svg>
    </button>
    <p class="fine">{tela11.fine}</p>
  </div>
</div>

<script>
import { VT } from '../lib/track';
import { prefetch } from 'astro:prefetch';
import { tela11 } from '../config/funnel';

const sim = JSON.parse(localStorage.getItem('vt_sim') || '{}');
const cond = JSON.parse(localStorage.getItem('vt_cond') || '{}');
const A: Record<string, string> = sim.answers || {};

const STEP = { step: 11, step_name: 'o_que_estava_por_tras' };
VT.track('step_view', { ...STEP, plan: sim.plan || null, tem_condicao: !!cond.code });
prefetch('/12');

/* ---- os seis passos, com as lacunas que cada um resolve ---- */
const PASSOS = tela11.passos;

/* lacunas vindas da simulação */
const falta: Record<string, boolean> = {
  checagem: !!A.checagem && A.checagem !== 'muda',
  conducao: (!!A.queixa && A.queixa !== 'perguntar') || (!!A.preco && A.preco !== 'tenho'),
};
const marcados = PASSOS.filter(p => p.resolve && falta[p.resolve]).map(p => p.n);

/* ordena: o que responde a lacuna dela primeiro, resto na ordem */
const ordem = [...PASSOS].sort((a, b) => {
  const A1 = marcados.includes(a.n) ? 0 : 1, B1 = marcados.includes(b.n) ? 0 : 1;
  return A1 - B1 || a.n - b.n;
});

document.getElementById('steps')!.innerHTML = ordem.map(p => {
  const hit = marcados.includes(p.n);
  return `<article class="step${hit ? ' hit' : ''}">
    <div class="top"><span class="n">${String(p.n).padStart(2, '0')}</span><h3>${p.t}</h3></div>
    <p>${p.d}</p>
    ${hit ? `<span class="why">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8"/></svg>
      ${(p as any).why}</span>` : ''}
  </article>`;
}).join('');

/* linha de recompensa e lede, conforme o que ela respondeu */
const rew = document.getElementById('reward')!;
rew.innerHTML = marcados.length ? tela11.rewardComMarcados : tela11.rewardSemMarcados;

if (sim.plan === 'basico') {
  document.getElementById('lede')!.textContent = tela11.ledeBasico;
}

/* ---- faixa da condição ---- */
if (cond.code && cond.expira_em) {
  const ate = new Date(cond.expira_em).getTime();
  document.getElementById('code')!.textContent = cond.code;
  (document.getElementById('strip') as HTMLElement).style.display = 'block';
  (function t() {
    const d = ate - Date.now(), el = document.getElementById('clock')!;
    if (d <= 0) { el.textContent = 'condição expirada'; return; }
    const h = Math.floor(d / 3.6e6), m = Math.floor(d % 3.6e6 / 6e4), s = Math.floor(d % 6e4 / 1000);
    el.textContent = `sua condição vale por ${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    setTimeout(t, 1000);
  })();
}

let advanced = false;
function reportExit() { if (!advanced) VT.track('step_exit', { ...STEP, marcados: marcados.length }); }
document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden') reportExit(); });
window.addEventListener('pagehide', reportExit);

document.getElementById('advance')!.addEventListener('click', () => {
  if (advanced) return; advanced = true;
  VT.track('step_advance', { ...STEP, plan: sim.plan || null, code: cond.code || null });
  document.getElementById('stage')!.classList.add('leaving');
  setTimeout(() => {
    window.location.href = `/12?s=${VT.sid}`;
  }, 420);
});
</script>

{/*
  POR QUE OS PASSOS SÃO REORDENADOS
  É o pagamento de tudo que a simulação guardou. Quem respondeu "não sei"
  na checagem vê Fitoterapia no topo, marcado, com o motivo escrito.
  Se a ordem for igual pra todo mundo, ela percebe em dois segundos que
  o diagnóstico era decorativo — e perde a confiança na reta final.

  ATENÇÃO AO REORDENAR: a numeração original (01 a 06) fica visível
  mesmo fora de ordem. Isso é de propósito: mostra que existe uma
  sequência canônica e que ela está vendo um recorte dela, não uma
  lista embaralhada.

  O QUE NÃO ENTRA NESTA TELA
  Preço. Nem "a partir de", nem "menos que um lanche". A tela 12 é a
  única que fala em dinheiro. Se o preço vazar pra cá, a lista de
  entregáveis passa a ser lida como justificativa de preço em vez de
  substância — e é justamente o contrário do que ela precisa fazer.

  A FAIXA DA CONDIÇÃO
  Sem ela, o pico da tela 10 evapora antes da tela de preço. Com ela,
  o relógio é real (conta do resgate dela) e o código é o mesmo que
  vai no checkout.
*/}
</FunnelLayout>
